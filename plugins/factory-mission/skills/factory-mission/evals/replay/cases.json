        {"type": "worker_started", "id": "start", "worker_id": "w1"},
        {"type": "worker_completed", "id": "worker-complete", "worker_id": "w1"},
        {"type": "mission_reported_complete", "id": "reported-complete"}
      ],
      "expected_status": "verifying",
      "expected_actions": ["prepare_and_supervise", "observe", "inspect_outcome", "verify_evidence"]
